{
  "name": "nlpwa",
  "version": "0.1.0",
  "description": "Native-like PWA framework with install-time caching and OTA hash-based delta updates",
  "type": "module",
  "author": "Arif",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arif891/nlpwa.git"
  },
  "homepage": "https://github.com/arif891/nlpwa#readme",
  "bugs": { "url": "https://github.com/arif891/nlpwa/issues" },
  "files": [
    "out",
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./sw":     "./out/sw.js",
    "./client": "./out/client.js",
    "./config": "./out/config.js",
    "./rollup": "./src/rollup-plugin.js"
  },
  "bin": {
    "nlpwa": "./bin/nlpwa.js"
  },
  "scripts": {
    "build":          "rollup -c",
    "build:prod":     "rollup -c --environment PROD",
    "dev":            "rollup -c --watch",
    "test":           "node --test test/**/*.test.js",
    "nlpwa":          "node ./bin/nlpwa.js",
    "nlpwa:update":   "node ./bin/nlpwa.js update",
    "nlpwa:help":     "node ./bin/nlpwa.js --help"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.0",
    "rollup": "^4.0.0"
  },
  "keywords": ["pwa", "service-worker", "offline", "cache", "ota-update", "cli"]
}
