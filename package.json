{
  "name": "nlpwa",
  "version": "0.1.0",
  "description": "Native-like PWA framework with install-time caching and OTA hash-based delta updates",
  "type": "module",
  "author": "Arif",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arif891/nlpwa.git"
  },
  "homepage": "https://github.com/arif891/nlpwa#readme",
  "bugs": { "url": "https://github.com/arif891/nlpwa/issues" },
  "files": [
    "out",
    "bin",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "types": "./types/index.d.ts",
  "exports": {
    "./sw": {
      "types": "./types/sw.d.ts",
      "import": "./out/sw.module.js",
      "default": "./out/sw.module.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./out/client.esm.js",
      "default": "./out/client.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "import": "./out/config.js",
      "default": "./out/config.js"
    },
    "./rollup": {
      "types": "./types/rollup.d.ts",
      "import": "./out/rollup-plugin.js",
      "default": "./out/rollup-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nlpwa": "./bin/nlpwa.js"
  },
  "scripts": {
    "build":          "rollup -c",
    "build:prod":     "rollup -c --environment PROD",
    "dev":            "rollup -c --watch",
    "test":           "node --test test/*.test.js",
    "prepublishOnly": "npm run build:prod && npm test",
    "nlpwa":          "node ./bin/nlpwa.js",
    "nlpwa:update":   "node ./bin/nlpwa.js update",
    "nlpwa:help":     "node ./bin/nlpwa.js --help",
    "example":        "node example/server.js"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.0",
    "rollup": "^4.0.0"
  },
  "keywords": ["pwa", "service-worker", "offline", "cache", "ota-update", "cli"]
}
