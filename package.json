{
  "name": "nlpwa",
  "version": "0.2.1",
  "description": "Native-like PWA framework with install-time caching and OTA hash-based delta updates",
  "type": "module",
  "author": "Arif",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arif891/nlpwa.git"
  },
  "homepage": "https://github.com/arif891/nlpwa#readme",
  "bugs": {
    "url": "https://github.com/arif891/nlpwa/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./out/client.esm.js",
  "module": "./out/client.esm.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./out/client.esm.js",
      "default": "./out/client.esm.js"
    },
    "./sw": {
      "types": "./types/sw.d.ts",
      "import": "./out/sw.module.js",
      "default": "./out/sw.module.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./out/client.esm.js",
      "default": "./out/client.esm.js"
    },
    "./config.json": {
      "types": "./types/config.d.ts",
      "default": "./out/api/update/config.json"
    },
    "./api/update/config.json": {
      "types": "./types/config.d.ts",
      "default": "./out/api/update/config.json"
    },
    "./rollup": {
      "types": "./types/rollup.d.ts",
      "import": "./out/rollup-plugin.js",
      "default": "./out/rollup-plugin.js"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "import": "./out/rollup-plugin.js",
      "default": "./out/rollup-plugin.js"
    },
    "./webpack": {
      "types": "./types/webpack.d.ts",
      "import": "./out/webpack-plugin.js",
      "default": "./out/webpack-plugin.js"
    },
    "./sync": {
      "types": "./types/sync.d.ts",
      "import": "./out/plugins/sync.js",
      "default": "./out/plugins/sync.js"
    },
    "./sync/client": {
      "types": "./types/sync-client.d.ts",
      "import": "./out/plugins/sync.client.esm.js",
      "default": "./out/plugins/sync.client.esm.js"
    },
    "./sync/sw": {
      "types": "./types/sync.d.ts",
      "default": "./out/plugins/sync.sw.js"
    },
    "./share": {
      "types": "./types/share.d.ts",
      "import": "./out/plugins/share.js",
      "default": "./out/plugins/share.js"
    },
    "./share/client": {
      "types": "./types/share.d.ts",
      "import": "./out/plugins/share.client.esm.js",
      "default": "./out/plugins/share.client.esm.js"
    },
    "./share/sw": {
      "types": "./types/share.d.ts",
      "default": "./out/plugins/share.sw.js"
    },
    "./badge": {
      "types": "./types/badge.d.ts",
      "import": "./out/plugins/badge.js",
      "default": "./out/plugins/badge.js"
    },
    "./badge/client": {
      "types": "./types/badge.d.ts",
      "import": "./out/plugins/badge.client.esm.js",
      "default": "./out/plugins/badge.client.esm.js"
    },
    "./badge/sw": {
      "types": "./types/badge.d.ts",
      "default": "./out/plugins/badge.sw.js"
    },
    "./bg-fetch": {
      "types": "./types/bg-fetch.d.ts",
      "import": "./out/plugins/bg-fetch.js",
      "default": "./out/plugins/bg-fetch.js"
    },
    "./bg-fetch/client": {
      "types": "./types/bg-fetch.d.ts",
      "import": "./out/plugins/bg-fetch.client.esm.js",
      "default": "./out/plugins/bg-fetch.client.esm.js"
    },
    "./bg-fetch/sw": {
      "types": "./types/bg-fetch.d.ts",
      "default": "./out/plugins/bg-fetch.sw.js"
    },
    "./crypto": {
      "types": "./types/crypto.d.ts",
      "import": "./out/plugins/crypto.js",
      "default": "./out/plugins/crypto.js"
    },
    "./sync/periodic": {
      "types": "./types/sync.d.ts",
      "import": "./out/plugins/sync.periodic.js",
      "default": "./out/plugins/sync.periodic.js"
    },
    "./sync/periodic/client": {
      "types": "./types/sync.d.ts",
      "import": "./out/plugins/sync.periodic.client.esm.js",
      "default": "./out/plugins/sync.periodic.client.esm.js"
    },
    "./sync/periodic/sw": {
      "types": "./types/sync.d.ts",
      "default": "./out/plugins/sync.periodic.js"
    },
    "./push": {
      "types": "./types/push.d.ts",
      "import": "./out/plugins/push.js",
      "default": "./out/plugins/push.js"
    },
    "./push/client": {
      "types": "./types/push.d.ts",
      "import": "./out/plugins/push.client.esm.js",
      "default": "./out/plugins/push.client.esm.js"
    },
    "./push/sw": {
      "types": "./types/push.d.ts",
      "default": "./out/plugins/push.sw.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "default": "./test/helpers/fake-env.js"
    },
    "./out/*": "./out/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "out",
    "src/cli",
    "src/client",
    "src/plugins",
    "src/shared",
    "src/sw",
    "src/config.js",
    "src/rollup-plugin.js",
    "src/webpack-plugin.js",
    "types",
    "test/helpers"
  ],
  "bin": {
    "nlpwa": "bin/nlpwa.js"
  },
  "scripts": {
    "build": "rollup -c --environment PROD && npm run sync:example",
    "build:dev": "rollup -c && npm run sync:example",
    "build:prod": "rollup -c --environment PROD && npm run sync:example",
    "pretest": "npm run build:prod",
    "dev": "rollup -c --watch",
    "test": "node --test test/*.test.js",
    "sync:example": "node ./bin/sync-example.js",
    "check:drift": "git diff --exit-code example/",
    "prepublishOnly": "npm run build:prod && npm test",
    "nlpwa": "node ./bin/nlpwa.js",
    "nlpwa:update": "node ./bin/nlpwa.js update",
    "nlpwa:help": "node ./bin/nlpwa.js --help",
    "example": "node example/server.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.0.0"
  },
  "keywords": [
    "pwa",
    "service-worker",
    "offline",
    "cache",
    "ota-update",
    "cli"
  ]
}
