{
  "version": "1.0.0",
  "configPath": "/config.json",
  "updateAPI": {
    "version": "/api/update/version.json",
    "info": "/api/update/info.json"
  },
  "precache": [
    "/",
    "/index.html",
    "/app.js",
    "/styles/main.css"
  ],
  "routes": [
    {
      "match": "/api/**",
      "strategy": "network-only"
    },
    {
      "match": "/assets/**",
      "strategy": "cache-first"
    }
  ],
  "defaultStrategy": "network-first"
}